{
  "info": {
    "_postman_id": "34f7f1a1-92f1-5cc0-826a-c84284527312",
    "name": "Ecommerce API",
    "description": "Every /api/v1 endpoint of ecommerce-spring-boot, in run order.\n\nStart the app (`./gradlew bootRun`), then run the whole collection with the Collection Runner. 'Sign in as admin' stores the access token; requests that create data store the new IDs; '9. Clean up' deletes what the run created, so it can be run repeatedly. Each request checks its status code.\n\nUses the seeded local accounts from R__insert_initial_data.sql (local development only).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Sign in as admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200]);",
                  "});",
                  "",
                  "if (pm.response.code < 300) {",
                  "  const body = pm.response.json();",
                  "  pm.test('response has accessToken', () => pm.expect(body.accessToken).to.be.a('string').and.not.empty);",
                  "  pm.collectionVariables.set('accessToken', body.accessToken);",
                  "  pm.test('response has refreshToken', () => pm.expect(body.refreshToken).to.be.a('string').and.not.empty);",
                  "  pm.collectionVariables.set('refreshToken', body.refreshToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "token"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{adminUsername}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Signs in and stores accessToken and refreshToken for the rest of the run."
          }
        },
        {
          "name": "Refresh access token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200]);",
                  "});",
                  "",
                  "if (pm.response.code < 300) {",
                  "  const body = pm.response.json();",
                  "  pm.test('response has accessToken', () => pm.expect(body.accessToken).to.be.a('string').and.not.empty);",
                  "  pm.collectionVariables.set('accessToken', body.accessToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/token/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "token",
                "refresh"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Exchanges the refresh token for a new access token (they expire after 15 minutes)."
          }
        }
      ]
